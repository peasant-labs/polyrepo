#!/usr/bin/env bash
# git-provision <url> <dir>
#
# Make a worktree host for one repository. The host holds an orphan
# __dummy__ branch, plus one worktree per available default/release
# branch (main, develop).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/lib.sh
source "${SCRIPT_DIR}/lib.sh"

if [ "$#" -ne 2 ]; then
  echo "usage: $(basename "$0") <url> <dir>" >&2
  exit 2
fi

url="$1"
dir="$2"

if ! git var GIT_COMMITTER_IDENT > /dev/null 2>&1; then
  die 1 "no git author identity" \
    "git var GIT_COMMITTER_IDENT failed; the git config and the environment hold no usable name and email" \
    "git-provision, pre-flight, before cloning ${url}" \
    "run git config --global user.name '<name>' and git config --global user.email '<email>'"
fi

if [ -e "${dir}" ]; then
  die 1 "target directory already exists" \
    "${dir} is already present, so git-provision will not overwrite it" \
    "git-provision, before cloning ${url} into ${dir}" \
    "remove or rename ${dir}, or pass a different dir"
fi

log "clone" "${url} -> ${dir}"
if ! git clone --no-checkout "${url}" "${dir}" > /dev/null; then
  die 1 "git clone failed" \
    "git clone --no-checkout could not fetch ${url} into ${dir}" \
    "git-provision, cloning ${url} into ${dir}" \
    "read the git message above; then check the ssh key on GitHub, the url in repos.txt, or the network"
fi

if ! (
  cd "${dir}"
  git switch --orphan __dummy__
  {
    echo "**/"
    echo "*/"
  } > .gitignore
  git add .gitignore
  git commit -q -m "host: ignore every worktree directory"
) > /dev/null; then
  die 1 "orphan host branch setup failed" \
    "git switch --orphan, git add or git commit did not succeed in ${dir}" \
    "git-provision, building the __dummy__ host branch in ${dir}" \
    "inspect ${dir} by hand; the partial clone is left in place for review"
fi

found_branch=0
for b in main develop; do
  if remote_branch_exists "${dir}" "${b}"; then
    if ! git -C "${dir}" worktree add -B "${b}" "${b}" "origin/${b}" > /dev/null; then
      die 1 "git worktree add failed" \
        "git worktree add could not create ${dir}/${b} from origin/${b}" \
        "git-provision, adding the ${b} worktree in ${dir}" \
        "inspect ${dir} by hand; the host and any earlier worktrees are left in place for review"
    fi
    log "worktree" "${dir}/${b} added from origin/${b}"
    found_branch=1
  else
    log "skip" "${dir}: no origin/${b}"
  fi
done

if [ "${found_branch}" -eq 0 ]; then
  die 1 "no known branch found" \
    "neither origin/main nor origin/develop exists in ${dir}" \
    "git-provision, branch loop, after cloning ${url} into ${dir}" \
    "inspect ${dir} by hand; the host is left in place for review"
fi
