#!/usr/bin/env bash
# sync-all
#
# Fast-forward the main/develop worktree of every provisioned repository.
# Takes no arguments.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/lib.sh
source "${SCRIPT_DIR}/lib.sh"

if [ "$#" -ne 0 ]; then
  echo "usage: $(basename "$0")" >&2
  exit 2
fi

POLYREPO_ROOT="${POLYREPO_ROOT:-$(dirname "${SCRIPT_DIR}")}"

if ! command -v git > /dev/null 2>&1; then
  die 1 "git is not on PATH" \
    "sync-all could not find the git command" \
    "sync-all, pre-flight" \
    "install git for your OS, then run scripts/sync-all again"
fi

if ! repo_lines="$(read_repos "${POLYREPO_ROOT}/repos.txt")"; then
  exit 2
fi

synced=0
failed=0

if [ -n "${repo_lines}" ]; then
  while IFS=' ' read -r _url dir; do
    host="${POLYREPO_ROOT}/${dir}"
    if [ ! -d "${host}" ]; then
      warn "repository host is missing" \
        "${host} does not exist" \
        "sync-all, ${dir}" \
        "run scripts/provision-all"
      failed=$((failed + 1))
      continue
    fi

    branch="$(default_branch "${host}")"
    if [ -z "${branch}" ]; then
      warn "no default branch" \
        "origin/HEAD could not be read for ${host}, even after an automatic attempt to set it" \
        "sync-all, ${dir}" \
        "confirm ${host} can reach origin (network, SSH key) with git -C ${host} fetch origin, then run git -C ${host} remote set-head origin <branch> by hand and check its output"
      failed=$((failed + 1))
      continue
    fi

    worktree="${host}/${branch}"
    if [ ! -d "${worktree}" ]; then
      warn "worktree is missing" \
        "${worktree} does not exist" \
        "sync-all, ${dir}" \
        "git -C ${dir} worktree add -B ${branch} ${branch} origin/${branch}"
      failed=$((failed + 1))
      continue
    fi

    if ! git -C "${worktree}" pull --ff-only > /dev/null; then
      warn "fast-forward pull failed" \
        "git -C ${worktree} pull --ff-only did not succeed; the local and remote branches may have diverged" \
        "sync-all, ${dir}/${branch}" \
        "inspect ${worktree} by hand and resolve the divergence"
      failed=$((failed + 1))
      continue
    fi

    log "synced" "${dir}/${branch}"
    synced=$((synced + 1))
  done <<< "${repo_lines}"
fi

log "done" "${synced} synced, ${failed} failed"

if [ "${failed}" -gt 0 ]; then
  exit 1
fi
