#!/usr/bin/env bash
# provision-all
#
# Provision every repository named in repos.txt that is not already
# present. Takes no arguments.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/lib.sh
source "${SCRIPT_DIR}/lib.sh"

if [ "$#" -ne 0 ]; then
  echo "usage: $(basename "$0")" >&2
  exit 2
fi

POLYREPO_ROOT="${POLYREPO_ROOT:-$(dirname "${SCRIPT_DIR}")}"

if ! command -v git > /dev/null 2>&1; then
  die 1 "git is not on PATH" \
    "provision-all could not find the git command" \
    "provision-all, pre-flight" \
    "install git for your OS, then run scripts/provision-all again"
fi

if ! repo_lines="$(read_repos "${POLYREPO_ROOT}/repos.txt")"; then
  exit 2
fi

provisioned=0
skipped=0
failed=0

if [ -n "${repo_lines}" ]; then
  while IFS=' ' read -r url dir; do
    target="${POLYREPO_ROOT}/${dir}"
    if [ -e "${target}" ]; then
      log "skip" "${dir} exists"
      skipped=$((skipped + 1))
      continue
    fi
    if ! "${SCRIPT_DIR}/git-provision" "${url}" "${target}"; then
      failed=$((failed + 1))
      continue
    fi
    provisioned=$((provisioned + 1))
  done <<< "${repo_lines}"
fi

log "done" "${provisioned} provisioned, ${skipped} skipped, ${failed} failed"

if [ "${failed}" -gt 0 ]; then
  exit 1
fi
